{
  "name": "@hungtrinh2001/docx-merger",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "High-performance TypeScript & JavaScript library for merging DOCX files with full OpenXML compliance.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hungtrinh2001/docx-merger.git"
  },
  "keywords": [
    "docx",
    "docx-merger",
    "merge docx",
    "word",
    "openxml",
    "office",
    "document",
    "composition"
  ],
  "author": "Hung Trinh <killdate123456@gmail.com>",
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/hungtrinh2001/docx-merger/issues"
  },
  "homepage": "https://github.com/hungtrinh2001/docx-merger#readme"
}
